{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdog-portal",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  // Custom domain. Cloudflare provisions the DNS record + TLS cert automatically;
  // requires mdog.me to be a zone in this Cloudflare account.
  "routes": [
    { "pattern": "birthday.mdog.me", "custom_domain": true }
  ],
  // Keep the *.workers.dev URL alive as a fallback alongside the custom domain.
  "workers_dev": true,
  "assets": {
    // Static site root. Served through the binding so the Worker can rewrite
    // the HTML (OG tags + China geo-gating) before responding.
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
