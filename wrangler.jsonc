{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdog-portal",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    // Static site root. Served through the binding so the Worker can rewrite
    // the HTML (OG tags + China geo-gating) before responding.
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
